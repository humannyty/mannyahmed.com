---
layout: layouts/base.njk
---
<header class="masthead">
  {#- Pre-rendered from art/masthead.svg (scripts/render-art.mjs). -#}
  <div class="scene" aria-hidden="true"></div>
  {% set inner = true %}{% include "partials/topbar.njk" %}
  <div class="head">
    {% if kicker %}<span class="small">{{ kicker }}</span>{% endif %}
    <h1>{{ title }}</h1>
    {% if sub %}<p class="sub">{{ sub }}</p>{% endif %}
  </div>
</header>
<main>
  <div class="wrap page">
    {{ content | safe }}
  </div>
  {% set slim = true %}{% include "partials/contact.njk" %}
</main>
